{
  "name": "dsh-study-tree",
  "version": "0.1.6",
  "description": "Learn through contextual session forks, a tree navigator, and native DeepSeek Harness chat.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "ARCHITECTURE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "learning",
    "session-fork"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.1-rc.2 <1.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.27.0",
    "react": "18.3.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-timeout=60000 test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:host": "node scripts/check-host.mjs",
    "prepack": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "duroey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duroey/dsh-study-tree.git"
  },
  "homepage": "https://github.com/duroey/dsh-study-tree#readme",
  "bugs": {
    "url": "https://github.com/duroey/dsh-study-tree/issues"
  }
}
